# Змінні середовища для локального запуску
# Скопіюйте цей файл у .env і заповніть значення

# ── ОБОВ'ЯЗКОВО ────────────────────────────────────────────────
# URL до XML-фіду вашого магазину в Хорошопі
# Приклад: https://total-energo.com.ua/sitemap.xml
#          або     https://total-energo.com.ua/export/pricelist.xml
HOROSHOP_FEED_URL=https://your-shop.horoshop.ua/export/products.xml

# ── АБО локальний файл для тестування ─────────────────────────
# Вкажіть шлях до локального XML файлу (замість URL)
# LOCAL_FEED_PATH=./test/horoshop-sample.xml

# ── НАЛАШТУВАННЯ ПРАЙС-ЛИСТА ────────────────────────────────────
# Фіксований залишок для всіх доступних товарів
DEFAULT_STOCK=10

# Ідентифікатор складу (латиниця, без / та \)
WAREHOUSE_ID=main

# Тип гарантії: "no", "manufacturer", "merchant"
WARRANTY_TYPE=no

# Тривалість гарантії в місяцях (0 = не вказувати)
WARRANTY_PERIOD=0

# Максимальна кількість платежів частинами
MAX_PAY_IN_PARTS=6

# Кількість днів до відправки (0=сьогодні, 1=завтра)
DAYS_TO_DISPATCH=1

# ── НАЗВА МАГАЗИНУ (для логів) ─────────────────────────────────
SHOP_NAME=Мій магазин

# ── НАЗВА PARAM ДЛЯ ШТРИХКОДУ ─────────────────────────────────
# Якщо штрихкод зберігається у param з нестандартною назвою — вкажіть її
# BARCODE_PARAM_NAME=Штрихкод

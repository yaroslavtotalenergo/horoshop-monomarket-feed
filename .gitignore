# Ignore everything in the root by default
/*

# But do not ignore these specific project files and folders
!/admin/
!/src/
!/feeds/
!/.github/
!/test/
!/package.json
!/package-lock.json
!/README.md
!/.gitignore
!/.env.example

# Inside the allowed folders, we might still want to ignore standard things:
/admin/node_modules/
/admin/dist/
node_modules/
.env
*.log
src/prom-config.json
src/google-sheets.json
src/warehouses.json
src/config.json
